# Database Configuration (Supabase / PostgreSQL)
# 1. DATABASE_URL: Transaction pooler connection string (Port 6543) - used by Next.js serverless functions on Vercel
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct database connection string (Port 5432) - used by Prisma migrations and CLI
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Authentication secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="your-super-secret-jwt-key-at-least-32-chars-long"

# Application URL
NEXT_PUBLIC_APP_URL="https://your-expense-tracker.vercel.app"

# Localization Defaults
DEFAULT_TIMEZONE="Asia/Kathmandu"
DEFAULT_CURRENCY="Rs."
