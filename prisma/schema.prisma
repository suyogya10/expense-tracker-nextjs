datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String?  @unique
  passwordHash  String
  name          String
  role          String   @default("USER") // ADMIN, USER
  currency      String   @default("Rs.")
  timezone      String   @default("Asia/Kathmandu")
  defaultSalary Decimal  @default(60000) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  salaryMonths      SalaryMonth[]
  categories        Category[]
  paymentMethods    PaymentMethod[]
  recurringExpenses RecurringExpense[]
  expenses          Expense[]
  incomes           Income[]
  budgets           Budget[]
}

model SalaryMonth {
  id          String   @id @default(cuid())
  userId      String
  name        String   // e.g. "September 2026"
  startDate   DateTime
  endDate     DateTime
  baseSalary  Decimal  @db.Decimal(12, 2)
  bonus       Decimal  @default(0) @db.Decimal(12, 2)
  otherIncome Decimal  @default(0) @db.Decimal(12, 2)
  totalIncome Decimal  @db.Decimal(12, 2)
  notes       String?
  status      String   @default("ACTIVE") // ACTIVE, CLOSED, UPCOMING
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomes            Income[]
  expenses           Expense[]
  budgets            Budget[]
  recurringInstances RecurringExpenseInstance[]

  @@index([userId, startDate, endDate])
  @@index([userId, status])
}

model Income {
  id            String   @id @default(cuid())
  userId        String
  salaryMonthId String
  source        String   // Salary, Bonus, Freelance, Gift, Refund, Other
  amount        Decimal  @db.Decimal(12, 2)
  date          DateTime
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  salaryMonth SalaryMonth @relation(fields: [salaryMonthId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([salaryMonthId, date])
}

model Category {
  id           String   @id @default(cuid())
  userId       String
  name         String
  icon         String   // Lucide icon name, e.g. "Utensils", "ShoppingCart"
  color        String   // Hex string, e.g. "#f97316"
  isInvestment Boolean  @default(false)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  budgets           Budget[]
  recurringExpenses RecurringExpense[]

  @@unique([userId, name])
}

model PaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  name      String   // Cash, Bank, Debit Card, Credit Card, eSewa, Khalti, Other
  icon      String   @default("CreditCard")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  @@unique([userId, name])
}

model Expense {
  id                  String   @id @default(cuid())
  userId              String
  salaryMonthId       String
  categoryId          String
  paymentMethodId     String?
  recurringInstanceId String?  @unique
  amount              Decimal  @db.Decimal(12, 2)
  date                DateTime
  description         String
  notes               String?
  isInvestment        Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  salaryMonth       SalaryMonth               @relation(fields: [salaryMonthId], references: [id], onDelete: Cascade)
  category          Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paymentMethod     PaymentMethod?            @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  recurringInstance RecurringExpenseInstance? @relation(fields: [recurringInstanceId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([salaryMonthId, date])
  @@index([categoryId])
}

model RecurringExpense {
  id              String    @id @default(cuid())
  userId          String
  categoryId      String
  paymentMethodId String?
  name            String
  amount          Decimal   @db.Decimal(12, 2)
  frequency       String    @default("MONTHLY") // MONTHLY, WEEKLY, YEARLY
  dayOfMonth      Int?      // 1 - 31 or relative day
  isInvestment    Boolean   @default(false)
  isEnabled       Boolean   @default(true)
  startDate       DateTime  @default(now())
  endDate         DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category                   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod?             @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  instances     RecurringExpenseInstance[]

  @@index([userId, isEnabled])
}

model RecurringExpenseInstance {
  id                 String   @id @default(cuid())
  recurringExpenseId String
  salaryMonthId      String
  expectedDate       DateTime
  amount             Decimal  @db.Decimal(12, 2)
  status             String   @default("PENDING") // PENDING, CONFIRMED, SKIPPED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  recurringExpense RecurringExpense @relation(fields: [recurringExpenseId], references: [id], onDelete: Cascade)
  salaryMonth      SalaryMonth      @relation(fields: [salaryMonthId], references: [id], onDelete: Cascade)
  expense          Expense?

  @@unique([recurringExpenseId, salaryMonthId])
  @@index([salaryMonthId, status])
}

model Budget {
  id            String   @id @default(cuid())
  userId        String
  salaryMonthId String
  categoryId    String
  amount        Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  salaryMonth SalaryMonth @relation(fields: [salaryMonthId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([salaryMonthId, categoryId])
  @@index([userId, salaryMonthId])
}
